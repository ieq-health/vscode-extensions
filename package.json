{
	"name": "ieq-vscode-extensions",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "node scripts/build.mjs check",
		"build": "node scripts/build.mjs bundle",
		"watch": "node scripts/build.mjs watch",
		"watch:types": "tsc --noEmit --watch --preserveWatchOutput -p .",
		"package": "node scripts/build.mjs package"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "~1.77.0",
		"@vscode/vsce": "^3.0.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.0.0"
	},
	"engines": {
		"node": ">=22",
		"vscode": "^1.77.0"
	}
}
