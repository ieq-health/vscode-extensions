{
	"publisher": "christianbrassat",
	"name": "firmendatenq",
	"displayName": "firmendatenQ",
	"description": "Insert Firmendaten",
	"version": "0.1.6",
	"repository": {
		"type": "git",
		"url": "https://github.com/ieq-health/vscode-extensions.git",
		"directory": "packages/firmendatenq"
	},
	"engines": {
		"vscode": "^1.77.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:firmendatenq.insertFirmendaten"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "firmendatenq.insertFirmendaten",
				"title": "firmendatenQ: Insert Firmendaten"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package --no-dependencies"
	}
}
