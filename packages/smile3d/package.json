{
	"publisher": "christianbrassat",
	"name": "smile3d",
	"displayName": "smile3d",
	"description": "Insert Smile-3D Videos made easy",
	"version": "0.0.3",
	"repository": {
		"type": "git",
		"url": "https://github.com/ieq-health/vscode-extensions.git",
		"directory": "packages/smile3d"
	},
	"engines": {
		"vscode": "^1.77.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:smile3d.insertvideo"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "smile3d.insertvideo",
				"title": "smile3d: Insert Video"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package --no-dependencies"
	}
}
