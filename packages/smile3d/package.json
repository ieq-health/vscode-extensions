{
	"publisher": "christianbrassat",
	"name": "smile3d",
	"displayName": "smile3d",
	"description": "Insert Smile-3D Videos made easy",
	"version": "0.0.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/ieq-health/vscode-smile3d.git"
	},
	"engines": {
		"vscode": "^1.30.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:smile3d.insertcontent"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "smile3d.insertvideo",
				"title": "smile3d: Insert Video"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"postinstall": "node ./node_modules/vscode/bin/install",
		"test": "npm run compile && node ./node_modules/vscode/bin/test"
	},
	"devDependencies": {
		"typescript": "^3.1.4",
		"vscode": "^1.1.25",
		"@types/node": "^8.10.25",
		"@types/mocha": "^2.2.42"
	}
}